using UnionRailway.AspNetCore;

namespace {{ Name }}.Presentation.WebApi.Shared.Middleware;

internal static class MiddlewareRegistrationExtensions
{
    internal static IServiceCollection AddDefaultMiddleware(this IServiceCollection services)
    {
        services.AddProblemDetails();
        services.AddCors(options =>
        {
            options.AddDefaultPolicy(builder =>
            {
                builder.AllowAnyOrigin()
                       .AllowAnyMethod()
                       .AllowAnyHeader();
            });
        });

        return services;
    }

    internal static WebApplication UseDefaultMiddleware(this WebApplication app)
    {
        app.UseRailwayExceptionHandler();
        app.UseStatusCodePages();
        app.UseCors();

        return app;
    }
}
