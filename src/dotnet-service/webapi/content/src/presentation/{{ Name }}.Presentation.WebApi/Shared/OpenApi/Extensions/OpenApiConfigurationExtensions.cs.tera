using UnionRailway;
using UnionRailway.AspNetCore;

namespace {{ Name }}.Presentation.WebApi.Shared.OpenApi.Extensions;

internal static class OpenApiConfigurationExtensions
{
	extension(IServiceCollection services)
	{
		internal IServiceCollection AddOpenApiSupport(IConfiguration configuration)
		{
			if (configuration is null)
				return services;

			Rail<{{ Name }}.Presentation.WebApi.Shared.OpenApi.Models.OpenApiConfiguration> configRail = configuration.GetOpenApiConfiguration();
			if (!configRail.IsSuccess(out {{ Name }}.Presentation.WebApi.Shared.OpenApi.Models.OpenApiConfiguration? openApi, out _))
				return services;

			_ = services.AddOpenApi(options =>
			{
				_ = options.AddDocumentTransformer(
					(document, _, _) =>
					{
						document.Info = new()
						{
							Title = openApi!.Title,
							Version = openApi!.Version,
							Description = openApi!.Description,
							Contact = new() { Name = openApi!.ContactName, Email = openApi!.ContactEmail },
							License = new() { Name = openApi!.LicenseName, Url = openApi!.LicenseUrl },
						};
						return Task.CompletedTask;
					}
				);
			});

			return services;
		}
	}

	extension(IConfiguration configuration)
	{
		internal Rail<{{ Name }}.Presentation.WebApi.Shared.OpenApi.Models.OpenApiConfiguration> GetOpenApiConfiguration()
		{
			if (configuration is null)
				return new UnionError.SystemFailure("Configuration instance is null.");

			IConfigurationSection section = configuration.GetSection("OpenApi");
			{{ Name }}.Presentation.WebApi.Shared.OpenApi.Models.OpenApiConfiguration? openApiConfig =
				section.Get<{{ Name }}.Presentation.WebApi.Shared.OpenApi.Models.OpenApiConfiguration>();

			if (openApiConfig is null)
				return new UnionError.Custom(
					Code: "CONFIG_MISSING_SECTION",
					Message: "OpenApi configuration section is missing. Ensure 'OpenApi' section with all required fields exists in configuration.",
					StatusCode: 500
				);

			return openApiConfig;
		}
	}

	extension(IApplicationBuilder app)
	{
		internal IApplicationBuilder UseOpenApiUi()
		{
			_ = app.UseRouting();
			_ = app.UseEndpoints(endpoints =>
			{
				_ = endpoints.MapOpenApi();
			});

			return app;
		}
	}
}
